---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionIcon from "./SectionIcon.astro";
import type { ProductSectionId } from "@/constants/product-sections";

interface Props {
  id: ProductSectionId;
  title: string;
  description: string;
  href: string;
  count: number;
  image?: ImageMetadata | string;
}

const { id, title, description, href, count, image } = Astro.props;
const imageClass =
  "absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transform-none";
---

<a
  href={href}
  class="group relative isolate flex h-full min-h-60 flex-col justify-between overflow-hidden rounded-3xl bg-primary p-6 text-white shadow-lg transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:shadow-2xl active:scale-[0.98] active:duration-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transform-none"
>
  {
    typeof image === "string" ? (
      <Image
        src={image}
        alt=""
        width={800}
        height={600}
        class={imageClass}
        loading="lazy"
      />
    ) : (
      image && (
        <Image
          src={image}
          alt=""
          width={800}
          class={imageClass}
          loading="lazy"
        />
      )
    )
  }

  <!-- Mismo velo azul del hero: garantiza legibilidad sobre cualquier foto -->
  <div
    class="absolute inset-0 -z-10"
    style="background: linear-gradient(100deg, rgba(1,51,131,0.94) 0%, rgba(35,48,96,0.82) 55%, rgba(1,51,131,0.45) 100%);"
  >
  </div>

  <div class="flex items-start justify-between gap-3">
    <span
      class="grid h-12 w-12 place-items-center rounded-2xl border border-white/20 bg-white/10 text-accent backdrop-blur-sm"
    >
      <SectionIcon section={id} class="h-6 w-6" />
    </span>
    <span
      class="text-[10px] font-semibold uppercase tracking-widest text-white/60"
    >
      {count}
      {count === 1 ? "producto" : "productos"}
    </span>
  </div>

  <div class="mt-10">
    <h3 class="text-xl font-extrabold leading-tight mb-1.5">{title}</h3>
    <p class="text-sm leading-relaxed text-white/75 max-w-xs">{description}</p>
    <span
      class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-widest text-accent"
    >
      Ver productos
      <svg
        class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transform-none"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
      </svg>
    </span>
  </div>
</a>
