---
import { Image } from "astro:assets";
import ScrollReveal from "@/components/shared/ScrollReveal";
import type { ImageMetadata } from "astro";

interface Props {
  image?: ImageMetadata;
  title?: string;
  badgeText?: string;
  p?: string;
  href?: string;
  cta?: string;
}

const { image, title, badgeText, p, href = "#", cta = "Conoce más" } = Astro.props;
---

<ScrollReveal client:visible direction="up" className="h-full">
  <div
    class="relative h-full overflow-hidden rounded-3xl bg-white dark:bg-slate-800 shadow-lg hover:shadow-2xl border border-slate-200/80 dark:border-slate-700/60 transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1"
  >
    <!-- Background subtle gradient effect on hover -->
    <div
      class="absolute -inset-1 bg-gradient-to-br from-primary/15 via-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 blur-lg pointer-events-none"
    >
    </div>

    <!-- Main Content Section -->
    <div class="p-6 md:p-8 flex flex-col flex-1 relative z-10">
      <!-- Image / Logo Box with white card background for crisp visibility in both light & dark mode -->
      {
        image && (
          <div class="w-full h-36 bg-white rounded-2xl p-5 mb-6 flex items-center justify-center border border-slate-200/80 dark:border-slate-700/50 shadow-sm relative overflow-hidden group-hover:bg-slate-50 transition-colors">
            <Image
              src={image}
              alt={title || "Brand image"}
              class="max-h-20 w-auto object-contain relative z-10 mix-blend-multiply drop-shadow-xs transition-transform duration-300 group-hover:scale-105"
            />
          </div>
        )
      }

      {
        badgeText && (
          <div class="mb-3">
            <span class="inline-block px-3 py-1 rounded-full bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light text-xs font-bold tracking-wider uppercase shadow-xs">
              {badgeText}
            </span>
          </div>
        )
      }

      {
        title && (
          <h3 class="text-2xl font-extrabold text-slate-900 dark:text-white mb-3 group-hover:text-primary transition-colors">
            {title}
          </h3>
        )
      }

      {
        p && (
          <p class="text-slate-600 dark:text-slate-300 text-sm md:text-base leading-relaxed mb-6 flex-1">
            {p}
          </p>
        )
      }

      {
        href && cta && (
          <div class="mt-auto pt-2">
            <a
              href={href}
              class="inline-flex items-center justify-center w-full px-5 py-3 text-sm font-bold text-white bg-primary hover:bg-primary/90 transition-all duration-300 rounded-xl shadow-md hover:shadow-primary/30 group-hover:shadow-lg"
            >
              {cta}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 ml-2 transition-transform group-hover:translate-x-1"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
          </div>
        )
      }
    </div>
  </div>
</ScrollReveal>
