---
import { Image } from "astro:assets";
import ScrollReveal from "@/components/shared/ScrollReveal";

interface Props {
  image: ImageMetadata;
  title?: string;
  badgeText?: string;
  p?: string;
  href?: string;
  cta?: string;
}

const { image, title, badgeText, p, href, cta } = Astro.props;
---

<section class="py-16 md:py-24">
  <div class="container-lg max-w-7xl mx-auto px-4 md:px-10">
    <ScrollReveal client:visible direction="up">
      <div class="relative overflow-hidden rounded-[2rem] bg-white dark:bg-slate-800 shadow-xl border border-slate-100 dark:border-slate-700/50 flex flex-col md:flex-row items-center group">
        <!-- Background Gradient Effect -->
        <div class="absolute -inset-1 bg-gradient-to-r from-primary/20 to-primary/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 blur-xl"></div>
        
        <!-- Content Side -->
        <div class="w-full md:w-3/5 p-8 md:p-14 lg:p-16 flex flex-col justify-center order-2 md:order-1 relative z-10">
          {badgeText && (
            <div class="mb-5 inline-flex">
              <span class="inline-block px-4 py-1.5 rounded-full bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light text-sm font-bold tracking-widest uppercase shadow-sm">
                {badgeText}
              </span>
            </div>
          )}
          
          {title && (
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 dark:text-white mb-6 leading-tight">
              {title}
            </h2>
          )}
          
          {p && (
            <p class="text-slate-600 dark:text-slate-300 text-lg md:text-xl leading-relaxed mb-8 max-w-2xl">
              {p}
            </p>
          )}
          
          {href && cta && (
            <div class="mt-2">
              <a 
                href={href} 
                class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-primary hover:bg-primary/90 transition-all duration-300 rounded-xl shadow-lg hover:shadow-primary/40 hover:-translate-y-1 active:translate-y-0"
              >
                {cta}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          )}
        </div>
        
        <!-- Image Side -->
        <div class="w-full md:w-2/5 p-8 md:p-12 flex items-center justify-center order-1 md:order-2 bg-slate-50 dark:bg-slate-200 min-h-[300px] relative z-10 border-b md:border-b-0 md:border-l border-slate-100 dark:border-slate-700/50">
          <div class="relative w-full max-w-[280px] md:max-w-[320px] aspect-square flex items-center justify-center">
            <!-- Decorative background blob -->
            <div class="absolute inset-0 bg-primary/5 dark:bg-primary/10 rounded-full filter blur-3xl transform scale-125 transition-transform duration-700 group-hover:scale-150"></div>
            
            <Image
              src={image}
              alt={title || "Brand image"}
              class="w-full h-auto object-contain relative z-10 max-h-[250px] mix-blend-multiply dark:mix-blend-multiply drop-shadow-sm transition-transform duration-500 group-hover:scale-105"
            />
          </div>
        </div>
      </div>
    </ScrollReveal>
  </div>
</section>
