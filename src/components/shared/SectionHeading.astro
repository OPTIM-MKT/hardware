---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  cta?: { label: string; href: string };
}

const { eyebrow, title, description, cta } = Astro.props;
---

<div
  class="flex flex-col md:flex-row items-start md:items-end justify-between mb-10 gap-4"
>
  <div>
    <span
      class="inline-block px-3 py-1 text-[10px] font-semibold uppercase tracking-widest rounded-full mb-3"
      style="background: rgba(250,183,2,0.12); color: #fab702;"
    >
      {eyebrow}
    </span>
    <h2
      class="text-3xl md:text-4xl font-extrabold text-primary dark:text-white mb-2 leading-tight"
    >
      {title}
    </h2>
    {
      description && (
        <p class="text-muted text-base leading-relaxed max-w-md">
          {description}
        </p>
      )
    }
  </div>
  {
    cta && (
      <a
        href={cta.href}
        class="inline-flex shrink-0 items-center gap-2 px-6 py-3 rounded-full font-semibold text-sm tracking-wide border border-line text-primary dark:text-white hover:border-primary hover:text-primary transition-[color,border-color,transform] duration-300 active:scale-[0.97] active:duration-100"
      >
        {cta.label}
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
        </svg>
      </a>
    )
  }
</div>
