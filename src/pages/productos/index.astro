---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ProductCatalog, {
  type CatalogProduct,
} from "../../components/productos/ProductCatalog";
import ContactForm from "../../components/contact/ContactForm";
import NoProducts from "../../components/productos/NoProducts.astro";
import ProductsDisclaimer from "@/components/productos/ProductsDisclaimer.astro";
import {
  CATALOG_PAGE_SIZE,
  compareRelevance,
  toCatalogProduct,
} from "@/components/productos/catalog-data";

// El catálogo completo (~9,300 productos) se descarga en el cliente desde
// /productos/catalogo.json; aquí solo va la primera página para el primer pintado.
export const prerender = true;

const items: CatalogProduct[] = (await getCollection("productos"))
  .map(toCatalogProduct)
  .sort(compareRelevance);

const initialProducts = items.slice(0, CATALOG_PAGE_SIZE);
const uniqueSorted = (values: string[]) =>
  [...new Set(values)].sort((a, b) => a.localeCompare(b, "es"));
const facets = {
  marcas: uniqueSorted(items.map((p) => p.marca)),
  categorias: uniqueSorted(items.map((p) => p.categoria)),
};
---

<Layout
  title="Productos | Hard-Ware – Catálogo de tecnología industrial"
  description="Explora el catálogo completo de productos Hard-Ware: impresoras, terminales, escáneres, equipos rugged, audio profesional y consumibles."
>
  <section
    class="w-full py-16 md:py-24 text-white"
    style="background: linear-gradient(135deg, #013383 0%, #233060 100%);"
  >
    <div class="container-lg text-center">
      <p
        class="text-xs font-semibold uppercase tracking-widest mb-3 opacity-60"
      >
        Catálogo
      </p>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4">Productos</h1>
      <p class="text-white/70 max-w-xl mx-auto text-base leading-relaxed">
        Tecnología industrial de marcas líderes. Filtra por categoría o marca,
        agrega al carrito y solicita tu cotización personalizada.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-lg">
      <ProductsDisclaimer />
      <ProductCatalog
        initialProducts={initialProducts}
        total={items.length}
        facets={facets}
        client:load
      >
        <NoProducts />
      </ProductCatalog>
    </div>
  </section>

  <section class="section-padding bg-slate-50 dark:bg-slate-950">
    <div class="container-lg">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-start">
        <div class="lg:col-span-2">
          <p
            class="text-[10px] font-semibold uppercase tracking-widest text-muted mb-2"
          >
            Solicita tu cotización
          </p>
          <h2
            class="text-2xl md:text-3xl font-bold text-black dark:text-white mb-4 leading-tight"
          >
            Agrega productos al carrito y <span
              class="text-primary dark:text-accent">cotízalos juntos</span
            >
          </h2>
          <p class="text-sm text-muted leading-relaxed mb-4">
            Construye tu lista desde el catálogo arriba, completa el formulario
            y recibe una propuesta consolidada en menos de 24 h hábiles.
            ¿Necesitas asesoría antes de elegir? Cambia a modo «Por proyecto» y
            cuéntanos qué quieres lograr.
          </p>
          <ul class="space-y-2 list-none p-0 m-0">
            {
              [
                "Precio por volumen y bundles",
                "Compatibilidad e integración garantizadas",
                "Acompañamiento postventa",
              ].map((bullet) => (
                <li class="flex items-start gap-2 text-sm text-ink dark:text-white">
                  <svg
                    class="w-4 h-4 mt-0.5 text-accent shrink-0"
                    fill="none"
                    stroke="currentColor"
                    stroke-width={2.5}
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m4.5 12.75 6 6 9-13.5"
                    />
                  </svg>
                  <span>{bullet}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="lg:col-span-3">
          <ContactForm initialMode="productos" client:visible />
        </div>
      </div>
    </div>
  </section>
</Layout>
